# Copie este arquivo para .env.local (que não é versionado) e preencha.

# Endereço onde o LicitacaoFactory foi publicado (saída de `npm run deploy`).
# Obrigatório para o frontend funcionar.
NEXT_PUBLIC_FACTORY_ADDRESS=

# --- Só necessário para publicar/usar uma rede pública (ex: Sepolia) ---
# Por padrão (sem nada abaixo) tudo roda contra uma blockchain local
# (`npm run chain`) em http://127.0.0.1:8545.

# URL do nó RPC. Ex de Sepolia via Infura:
# RPC_URL=https://sepolia.infura.io/v3/<sua_chave_infura>
# Usada também pelo frontend quando não há MetaMask instalado:
# NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/<sua_chave_infura>
RPC_URL=
NEXT_PUBLIC_RPC_URL=

# Mnemônico de uma carteira SÓ DE TESTE, usada apenas por `npm run deploy`
# pra assinar o deploy numa rede pública. NUNCA use uma carteira com fundos
# reais ou reaproveitada de outro lugar, e nunca commite esse arquivo.
DEPLOYER_MNEMONIC=
